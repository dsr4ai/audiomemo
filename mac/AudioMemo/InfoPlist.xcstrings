        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Az AudioMemo rögzíti a Macen lejátszott hangot (értekezletek, videók)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "AudioMemo はこの Mac で再生される音（会議、動画）を録音します。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "AudioMemo บันทึกเสียงที่เล่นบน Mac เครื่องนี้ (การประชุม วิดีโอ)"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "needs_review",
            "value": "AudioMemo 會錄下這台 Mac 播出的聲音（會議、影片）。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "AudioMemo 会录下这台 Mac 播放的声音（会议、视频）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "AudioMemo 會錄下這台 Mac 播出的聲音（會議、影片）。"
          }
        }
      }
    },
