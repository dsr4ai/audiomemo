    "NSAudioCaptureUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يسجّل AudioMemo الصوت الذي يُشغَّل على هذا الـ Mac (الاجتماعات والفيديوهات)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "AudioMemo nimmt den Ton auf, der auf diesem Mac abgespielt wird (Meetings, Videos)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AudioMemo records the sound playing on this Mac (meetings, videos)."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "needs_review",
            "value": "AudioMemo records the sound playing on this Mac (meetings, videos)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "AudioMemo graba el sonido que se reproduce en este Mac (reuniones, videos)."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "needs_review",
