    "hint.whatIsRecorded": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يسجّل كل ما يشغّله هذا الـ Mac ‏(Zoom وTeams وMeet والفيديوهات) مع الميكروفون."
