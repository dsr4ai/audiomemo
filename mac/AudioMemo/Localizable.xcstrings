    "settings.airpodsNote": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "«مثل النظام» يستخدم مدخل الصوت الحالي في الـ Mac، وينتقل تلقائيًا إلى الميكروفون الذي يستخدمه تطبيق الاتصال (مثل Zoom). ميكروفونات البلوتوث تحوّل الصوت إلى جودة المكالمات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "„Wie System“ verwendet den aktuellen Eingang des Mac und wechselt automatisch zu dem Mikrofon, das eine Anruf-App (z. B. Zoom) nutzt. Bluetooth-Mikrofone schalten auf Telefonqualität um."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“Same as System” uses the Mac’s current input, and switches to the mic a call app (like Zoom) is using. Bluetooth mics switch audio to call quality."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "needs_review",
            "value": "“Same as System” uses the Mac’s current input, and switches to the mic a call app (like Zoom) is using. Bluetooth mics switch audio to call quality."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "«Igual que el sistema» usa la entrada actual del Mac y cambia automáticamente al micrófono que usa una app de llamadas (como Zoom). Los micrófonos Bluetooth pasan a calidad de llamada."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "needs_review",
            "value": "«Igual que el sistema» usa la entrada actual del Mac y cambia automáticamente al micrófono que usa una app de llamadas (como Zoom). Los micrófonos Bluetooth pasan a calidad de llamada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "« Comme le système » utilise l’entrée actuelle du Mac et passe automatiquement au micro utilisé par une app d’appel (comme Zoom). Les micros Bluetooth passent en qualité téléphonique."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A „Rendszer szerint” a Mac aktuális bemenetét használja, és automatikusan átvált arra a mikrofonra, amelyet egy hívásalkalmazás (pl. Zoom) használ. A Bluetooth-mikrofonok telefonminőségre váltanak."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "「システムと同じ」は Mac の現在の入力を使い、通話 App（Zoom など）が使っているマイクに自動で切り替えます。Bluetooth マイクを使うと通話品質になります。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "“ตามระบบ” จะใช้อุปกรณ์รับเสียงปัจจุบันของ Mac และสลับไปใช้ไมโครโฟนที่แอปประชุม (เช่น Zoom) กำลังใช้โดยอัตโนมัติ ไมโครโฟนบลูทูธจะทำให้เสียงเป็นคุณภาพสายโทรศัพท์"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "needs_review",
            "value": "「跟隨系統」會用 Mac 目前的輸入裝置，並自動跟上視訊 App（例如 Zoom）正在用的麥克風。藍牙麥克風會讓聲音變成通話音質。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "“跟随系统”会使用 Mac 当前的输入设备，并自动切换到视频会议 App（如 Zoom）正在使用的麦克风。蓝牙麦克风会让声音变成通话音质。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「跟隨系統」會用 Mac 目前的輸入裝置，並自動跟上視訊 App（例如 Zoom）正在用的麥克風。藍牙麥克風會讓聲音變成通話音質。"
          }
        }
      }
    },
