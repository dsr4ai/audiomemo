    "settings.echoNote": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "new",
            "value": "Automatic turns it on when sound plays through speakers (so your mic doesn't pick it up again) and off with headphones. While it's on, Control Center › Mic Mode (Voice Isolation, Wide Spectrum) applies to AudioMemo. For a Bluetooth speaker, choose Always On."
          }
        },
