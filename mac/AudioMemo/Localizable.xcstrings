    "notice.bluetooth": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ميكروفونات البلوتوث تحوّل التسجيل وسماعات الرأس إلى جودة المكالمات. يُفضّل استخدام ميكروفون الـ Mac أو الـ iPhone"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bluetooth-Mikrofone schalten Aufnahme und Kopfhörer auf Telefonqualität. Nutze lieber das Mikrofon von Mac oder iPhone."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth mics switch recording and headphones to call quality. Use the Mac or iPhone mic instead."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bluetooth mics switch recording and headphones to call quality. Use the Mac or iPhone mic instead."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Los micrófonos Bluetooth pasan la grabación y los auriculares a calidad de llamada. Mejor usa el micrófono del Mac o del iPhone."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Los micrófonos Bluetooth pasan la grabación y los auriculares a calidad de llamada. Mejor usa el micrófono del Mac o del iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un micro Bluetooth fait passer l’enregistrement et le casque en qualité téléphonique. Préférez le micro du Mac ou de l’iPhone."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A Bluetooth-mikrofon a felvételt és a fejhallgatót is telefonminőségre váltja. Használd inkább a Mac vagy az iPhone mikrofonját."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bluetooth マイクを使うと録音とヘッドフォンが通話品質になります。Mac か iPhone のマイクをおすすめします"
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ไมโครโฟนบลูทูธทำให้การบันทึกและหูฟังเป็นคุณภาพสายโทรศัพท์ แนะนำให้ใช้ไมโครโฟนของ Mac หรือ iPhone"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "needs_review",
            "value": "藍牙麥克風會讓錄音與耳機變成通話音質，建議改用 Mac 或 iPhone 的麥克風"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "蓝牙麦克风会让录音和耳机变成通话音质，建议改用 Mac 或 iPhone 的麦克风"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "藍牙麥克風會讓錄音與耳機變成通話音質，建議改用 Mac 或 iPhone 的麥克風"
          }
        }
      }
    },
