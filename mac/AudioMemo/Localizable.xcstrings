          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "AudioMemo 无法使用麦克风。请前往“系统设置 › 隐私与安全性 › 麦克风”打开。"
          }
        },
        "zh-Hant": {
