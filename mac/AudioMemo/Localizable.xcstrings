    "settings.autoLevelNote": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يرفع الأصوات والمكالمات الخافتة إلى مستوى متقارب، ولا يضخّم ضوضاء الخلفية. يُطبَّق من التسجيل التالي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Leise Stimmen und leise Anrufe werden auf ein ähnliches Niveau angehoben; Hintergrundrauschen wird nicht verstärkt. Gilt ab der nächsten Aufnahme."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quiet voices and quiet calls are brought up to a similar level; background noise isn't amplified. Applies to the next recording."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Quiet voices and quiet calls are brought up to a similar level; background noise isn't amplified. Applies to the next recording."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Las voces y llamadas bajas suben a un nivel parecido; el ruido de fondo no se amplifica. Se aplica desde la próxima grabación."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Las voces y llamadas bajas suben a un nivel parecido; el ruido de fondo no se amplifica. Se aplica desde la próxima grabación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les voix et appels faibles sont remontés à un niveau similaire ; le bruit de fond n’est pas amplifié. S’applique au prochain enregistrement."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A halk hangokat és hívásokat hasonló szintre emeli; a háttérzajt nem erősíti. A következő felvételtől érvényes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "小さな声や相手の声を同じくらいの音量に上げます。背景ノイズだけのときは上げません。次の録音から適用されます。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "เพิ่มเสียงพูดหรือเสียงสายที่เบาให้ใกล้เคียงกัน โดยไม่ขยายเสียงรบกวนพื้นหลัง มีผลตั้งแต่การบันทึกครั้งถัดไป"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "needs_review",
            "value": "說話或對方聲音太小時自動拉大到相近的音量，只有背景雜音時不放大。下一次錄音起生效。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "说话或对方声音太小时自动调大到相近的音量，只有背景噪音时不放大。下次录音起生效。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "說話或對方聲音太小時自動拉大到相近的音量，只有背景雜音時不放大。下一次錄音起生效。"
          }
        }
      }
    },
